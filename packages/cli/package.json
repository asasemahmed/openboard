    "@openboard/mcp": "workspace:*",
    "@openboard/sdk": "workspace:*",
    "@openboard/server": "workspace:*",
    "commander": "^15.1.0",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "scripts": {
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE"
