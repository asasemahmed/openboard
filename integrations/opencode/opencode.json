{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "openboard": {
        "type": "local",
        "command": [
          "/absolute/path/to/node",
          "/absolute/path/to/openboard/packages/cli/dist/bin.js",
          "mcp",
          "--root",
          "/absolute/path/to/your/project"
        ]
      }
    }
  }
}
