{
  "description": "Reports what Codex is doing to the project's running OpenBoard server (openboard hook).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OPENBOARD_AGENT_ID=codex OPENBOARD_AGENT_NAME=Codex /absolute/path/to/node /absolute/path/to/openboard/packages/cli/dist/bin.js hook --format claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OPENBOARD_AGENT_ID=codex OPENBOARD_AGENT_NAME=Codex /absolute/path/to/node /absolute/path/to/openboard/packages/cli/dist/bin.js hook --format claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OPENBOARD_AGENT_ID=codex OPENBOARD_AGENT_NAME=Codex /absolute/path/to/node /absolute/path/to/openboard/packages/cli/dist/bin.js hook --format claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OPENBOARD_AGENT_ID=codex OPENBOARD_AGENT_NAME=Codex /absolute/path/to/node /absolute/path/to/openboard/packages/cli/dist/bin.js hook --format claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OPENBOARD_AGENT_ID=codex OPENBOARD_AGENT_NAME=Codex /absolute/path/to/node /absolute/path/to/openboard/packages/cli/dist/bin.js hook --format claude-code",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "OPENBOARD_AGENT_ID=codex OPENBOARD_AGENT_NAME=Codex /absolute/path/to/node /absolute/path/to/openboard/packages/cli/dist/bin.js hook --format claude-code",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
