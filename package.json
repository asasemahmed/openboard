{
  "name": "openboard-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The open canvas for AI agents.",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && vite build packages/app",
    "build:libs": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b && tsc -p packages/app --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "openboard": "node packages/cli/dist/bin.js",
    "evals": "node packages/evals/dist/bin.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
